# Only these two are required to boot in development.
GEMINI_API_KEY=your_api_key_here
API_SECRET_KEY=your_secret_key_here

# API_SECRET_KEY above is the legacy dev-convenience fallback (phase 14):
# real scoped keys are created with `uv run python scripts/manage_api_keys.py
# create --principal <name> --scopes <scope...>` and never live in this file.

# "development" (default) never blocks startup on a soft-missing secret.
# "production" fails startup loudly if HONEYPOT_ENABLED has no
# HONEYPOT_RESEARCHER_KEY, or a bot token is set with no matching webhook
# secret (phase 14) -- and gates the HSTS response header on requests that
# arrive with X-Forwarded-Proto: https.
# ENVIRONMENT=production

# --- LLM providers ----------------------------------------------------------
# Every provider below is optional. Uncomment and fill only the ones you have
# keys for -- an unconfigured provider reports DISABLED and the task router
# (packages/llm/router/task_router.py) skips it automatically. With none
# configured, GEMINI_API_KEY above still runs everything. Any *_API_KEY
# accepts a comma-separated list of keys for failover.

# Force one provider to the front of every task's chain (reasoning/fast/
# vision/structured). Leave unset to use the default capability-ordered chain.
# LLM_PROVIDER=ollama
# Per-task override, JSON: {"reasoning": ["ollama", "gemini"]}
# LLM_TASK_ROUTES=
# LLM_TIMEOUT_SECONDS=20
# LLM_SEED=7

# Ollama -- local models, nothing leaves the host. Off by default because a
# local endpoint that's usually absent would otherwise fail a connection
# before every failover.
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma3:4b

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5

# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/auto

# --- Channels -----------------------------------------------------------
# Each channel is optional. Without its secret the webhook rejects every
# request -- an unauthenticated webhook is never acted on.

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_API_BASE=https://api.telegram.org

# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v21.0

# --- Deploy (EC2 / any non-localhost host) ---------------------------------
# Both default to localhost, which only works for local dev. On EC2, caddy
# (infra/docker/Caddyfile) fronts web on :443 and api on :8443 for the same
# domain -- set these to that domain before building there. NEXT_PUBLIC_API_URL
# is baked into the web image at build time (docker-compose.yml's `web` build
# args), so change it *before* `docker compose build`, not after.
# NEXT_PUBLIC_API_URL=https://rakshak-ai.duckdns.org:8443
# CORS_ALLOWED_ORIGINS=https://rakshak-ai.duckdns.org

# --- Persistence ----------------------------------------------------------
# Unset means in-memory/per-process fallbacks (session state, rate limiting,
# webhook dedup) and the async job queue degrades to running investigations
# inline instead of enqueueing them. `docker compose up` (docker-compose.yml)
# provisions all three below for local testing.
# DATABASE_URL=postgresql+asyncpg://rakshak:rakshak@localhost:5432/rakshak
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=rakshak
# S3_SECRET_KEY=rakshak123
# S3_BUCKET=rakshak-evidence
# S3_REGION=us-east-1

# --- Honeypot isolation ----------------------------------------------------
# Off by default -- rule #8, a consumer request never enters the honeypot
# automatically. HONEYPOT_RESEARCHER_KEY is a separate secret from
# API_SECRET_KEY on purpose.
# HONEYPOT_ENABLED=false
# HONEYPOT_RESEARCHER_KEY=

# --- Deployment mode --------------------------------------------------------
# DEPLOYMENT_MODE=lite skips loading transformers/torch (uv sync --extra ml
# not required) -- a dev convenience, not a production sizing target.
# DEPLOYMENT_MODE=full
# HF_LITE_MODE=false

# --- Observability ----------------------------------------------------------
# Both unset means off, same DISABLED-not-a-stub convention as everything else
# here -- a laptop with neither still runs.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# SENTRY_DSN=
