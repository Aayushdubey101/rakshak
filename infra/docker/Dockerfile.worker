# Rakshak async worker image (task.md phase 13/15). Build from the
# repository root:
#   docker build -f infra/docker/Dockerfile.worker -t rakshak-worker .
#
# Same builder stage as Dockerfile.api -- one arq worker process consuming
# the queue apps/worker/settings.py defines, no new distributed
# infrastructure beyond the Redis both images share.

FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

ARG INSTALL_ML=true

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    if [ "$INSTALL_ML" = "true" ]; then \
        uv sync --frozen --no-install-project --no-dev --extra ml; \
    else \
        uv sync --frozen --no-install-project --no-dev; \
    fi

COPY . .

RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$INSTALL_ML" = "true" ]; then \
        uv sync --frozen --no-dev --extra ml; \
    else \
        uv sync --frozen --no-dev; \
    fi

FROM python:3.11-slim

RUN groupadd --system rakshak && useradd --system --gid rakshak --home /app rakshak

WORKDIR /app
COPY --from=builder --chown=rakshak:rakshak /app /app

# See Dockerfile.api for why this is needed: WORKDIR creates /app
# root-owned before --chown can apply to it.
RUN mkdir -p /app/data && chown rakshak:rakshak /app /app/data

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER rakshak

# No HTTP surface to health-check; ECS watches the container process itself
# (task.md phase 15's ECS/Fargate services), same as any arq deployment.
CMD ["arq", "apps.worker.settings.WorkerSettings"]
