# Rakshak API image (task.md phase 15). Build from the repository root:
#   docker build -f infra/docker/Dockerfile.api -t rakshak-api .
#
# ARG INSTALL_ML=true pulls in torch/transformers (the `ml` extra,
# packages/ml/inference/hf.py). Set to `false` for a lean lite-mode image --
# HF_LITE_MODE=true then keeps the app on pattern + threat-intel signals only
# (task.md's documented lite-mode contract), still a valid report.
#
# ARG INSTALL_SEMANTIC=true pulls in sentence-transformers (the `semantic`
# extra, packages/ml/text/semantic.py -- Phase 10's MiniLM classifier).
# Independent of INSTALL_ML: this runs unconditionally once installed, no
# DEPLOYMENT_MODE/HF_LITE_MODE gate, same as the TF-IDF supervised classifier.
# CPU-only torch wheel (pyproject.toml's [tool.uv.sources]/[tool.uv.index]),
# no CUDA. The encoder weights (~87MB) download from Hugging Face on first
# use and are NOT baked into the image here -- see
# docs/ml/phase10-semantic-evaluation.md's Docker section for what that means
# for cold start / offline deploys.
#
# ARG INSTALL_OCR=true pulls in easyocr (the `ocr` extra,
# packages/ml/vision/ocr.py) -- local screenshot text extraction, tried
# before the gateway vision LLM call. Reuses the same CPU-only torch wheel
# as INSTALL_SEMANTIC.

FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

ARG INSTALL_ML=true
ARG INSTALL_SEMANTIC=true
ARG INSTALL_OCR=true

# Dependencies first (own layer, cached across source-only changes).
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    extras=""; \
    if [ "$INSTALL_ML" = "true" ]; then extras="$extras --extra ml"; fi; \
    if [ "$INSTALL_SEMANTIC" = "true" ]; then extras="$extras --extra semantic"; fi; \
    if [ "$INSTALL_OCR" = "true" ]; then extras="$extras --extra ocr"; fi; \
    uv sync --frozen --no-install-project --no-dev $extras

COPY . .

RUN --mount=type=cache,target=/root/.cache/uv \
    extras=""; \
    if [ "$INSTALL_ML" = "true" ]; then extras="$extras --extra ml"; fi; \
    if [ "$INSTALL_SEMANTIC" = "true" ]; then extras="$extras --extra semantic"; fi; \
    if [ "$INSTALL_OCR" = "true" ]; then extras="$extras --extra ocr"; fi; \
    uv sync --frozen --no-dev $extras

FROM python:3.11-slim

RUN groupadd --system rakshak && useradd --system --gid rakshak --home /app rakshak

WORKDIR /app
COPY --from=builder --chown=rakshak:rakshak /app /app

# WORKDIR creates /app root-owned *before* the COPY above runs, and
# --chown only applies to the copied contents, not that pre-existing
# directory entry -- so the non-root user below couldn't write a new
# top-level path (data/rakshak.db, data/objects/, packages/shared/db/engine.py's
# sqlite/local-object-store fallback) without this.
RUN mkdir -p /app/data /app/.EasyOCR && chown rakshak:rakshak /app /app/data /app/.EasyOCR

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PORT=10000

USER rakshak
EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,os; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",10000)}/health/live', timeout=3)" || exit 1

CMD ["python", "main.py"]
